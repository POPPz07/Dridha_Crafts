# ==============================================================================
# Dridha Crafts - Backend Environment Variables Template
# ==============================================================================
# Use this template for local development configuration (.env)
# and reference these keys when adding environment variables in Render / Railway.
# ==============================================================================

# ── Application Environment ──────────────────────────────────────────────────
APP_NAME=Dridha Crafts API
APP_VERSION=1.0.0
# Set DEBUG=false and ENVIRONMENT=production for live deployments
DEBUG=true
ENVIRONMENT=development

# ── Supabase Cloud Infrastructure ─────────────────────────────────────────────
# Found in: Supabase Dashboard -> Project Settings -> API & Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-jwt-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars

# Database Connection URI (PgBouncer Transaction Pooler on port 6543)
# Note: If password contains '@', encode it as '%40'
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Security & CORS Settings ──────────────────────────────────────────────────
# Local development: ["http://localhost:3000"]
# Production deployment: ["https://dridhacrafts.vercel.app", "https://your-custom-domain.com"]
CORS_ORIGINS=["http://localhost:3000"]

RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_GENERAL=60/minute

# ── Transactional Email (Resend) ──────────────────────────────────────────────
# Obtain API key from https://resend.com (optional for local testing)
RESEND_API_KEY=
FROM_EMAIL=craftsdridha@gmail.com

# ── Payment & UPI ─────────────────────────────────────────────────────────────
UPI_ID=dridhacrafts@upi
GOOGLE_PAY_QR_URL=
