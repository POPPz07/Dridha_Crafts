# Dridha Crafts - Backend Environment Variables
APP_NAME=Dridha Crafts API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Supabase (Get from your Supabase Project Settings -> API & Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Security & CORS
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_GENERAL=60/minute

# Payment & Email (Optional for development)
RESEND_API_KEY=
FROM_EMAIL=orders@dridhacrafts.com
UPI_ID=
GOOGLE_PAY_QR_URL=
