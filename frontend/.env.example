# ==============================================================================
# Dridha Crafts - Frontend Environment Variables Template
# ==============================================================================
# Use this template for local development configuration (.env.local)
# and reference these keys when configuring Environment Variables in Vercel.
# ==============================================================================

# ── Supabase (Public Client) ──────────────────────────────────────────────────
# Matches SUPABASE_URL from backend
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Matches SUPABASE_ANON_KEY from backend (Safe for public browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-jwt-key

# ── Backend API Endpoint ──────────────────────────────────────────────────────
# Local development: http://localhost:8000
# Production deployment: https://your-backend-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
